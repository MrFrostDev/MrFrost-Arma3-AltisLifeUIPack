# Arma 3 sources are plain text; keep them LF in the repository so diffs stay
# stable regardless of who checks them out.
*           text=auto eol=lf

*.sqf       text eol=lf
*.hpp       text eol=lf
*.ext       text eol=lf
*.cpp       text eol=lf
*.sql       text eol=lf
*.ini       text eol=lf
*.xml       text eol=lf
*.md        text eol=lf

# Written by the Eden editor; preserve byte-for-byte, never normalise.
*.sqm       -text

*.paa       binary
*.jpg       binary
*.png       binary
*.zip       binary

# Language stats should reflect what was actually written here.
*.sqf       linguist-language=SQF
*.hpp       linguist-language=C++

